  "item": [
    {
      "id": "76355022-acd3-4e8b-80a5-a2ae547ac932",
      "name": "Books",
      "description": {
        "content": "Query and retrieve metadata for Project Gutenberg ebooks.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ef8cb65a-a2a0-45bb-9a3e-3b13221029d6",
          "name": "List Books",
          "request": {
            "name": "List Books",
            "description": {
              "content": "Returns a paginated list of book metadata from the Project Gutenberg catalog. Results are returned 32 per page and can be filtered by author birth/death year, copyright status, Project Gutenberg IDs, languages, MIME type, search keywords, and topic. By default books are sorted by popularity (download count, descending).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "books"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "author_year_start",
                  "value": "<integer>",
                  "description": "Find books with at least one author alive on or after this year. Accepts positive or negative integers (negative for BCE)."
                },
                {
                  "disabled": false,
                  "key": "author_year_end",
                  "value": "<integer>",
                  "description": "Find books with at least one author alive on or before this year. Accepts positive or negative integers (negative for BCE)."
                },
                {
                  "disabled": false,
                  "key": "copyright",
                  "value": "<string>",
                  "description": "Filter by copyright status. Comma-separated values among `true` (copyrighted), `false` (public domain in the USA), and `null` (no available copyright information)."
                },
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "Comma-separated list of Project Gutenberg ID numbers to retrieve."
                },
                {
                  "disabled": false,
                  "key": "languages",
                  "value": "<string>",
                  "description": "Comma-separated two-character language codes. Returns books in any of the listed languages."
                },
                {
                  "disabled": false,
                  "key": "mime_type",
                  "value": "<string>",
                  "description": "Prefix-matched MIME type. Returns books that have at least one format whose MIME type starts with this value."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Space-separated keywords searched case-insensitively across author names and book titles. Up to 32 terms are honored."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "popular",
                  "description": "Sort order. `popular` (default) sorts by download count descending, `ascending` sorts by Project Gutenberg ID ascending, `descending` sorts by ID descending."
                },
                {
                  "disabled": false,
                  "key": "topic",
                  "value": "<string>",
                  "description": "Case-insensitive key-phrase matched against bookshelf names and subject headings."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
